# Reserved for future Supabase Auth, Storage, or Realtime integration; not used by this setup.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SQLite is the selected hackathon database. The path is relative to the backend working directory.
DATABASE_URL=sqlite:///./sahara.db
# Optional read-only PostgreSQL connection used only by the integration test; set explicitly to run it.
TEST_POSTGRESQL_DATABASE_URL=
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_MINUTES=60
ROUTE_DEVIATION_METERS=500
MAX_UPLOAD_MB=15
DEMO_MODE=true
